---
import Checkicon from "./icons/Check.astro";



const INCLUDES = {
  LANDING: {
    a:"Copywriting with a focus on conversions",    
    b:"SEO-ready structure",
    c:"Integration with analytics & automation tools",
  },
  AUTOMATION: {
    a:"N8N Automation",
    b:"API integrations",
    c:"Scalable architecture",
    d:"Fast and optimized performance ",
  },
  CONTENT: {
    a:"Content structure planning (landing pages, microsites) ",
    b:"Workflow automation (CRM integration) ",
    c:"Guidance on digital growth strategies",    
  },
};


const SERVICES = [
  {
    title: "Landing Page Development",
    description:
      "High-converting landing pages designed to generate leads and sales. Built with modern tools like WordPress (Bricks, Elementor) or custom frameworks.",
    image: "/projects/rocket2.svg",
    services: [INCLUDES.LANDING],
  },
  {
    title: "Custom Micro Saas App",
    description:
      "Tailored web apps built with modern frameworks such as Next.js, Ract, or Astro. Perfect for businesses that need more than just a website.",
    image: "/projects/app.svg",
    services: [INCLUDES.AUTOMATION],
  },
  {
    title: "Content Strategy",
    description:
      "I help you plan content structures, integrate automations, and set up technical SEO so your site works smarter, not harder.",
    image: "/projects/social.svg",
    services: [INCLUDES.CONTENT],
  },
];
---

<section
  id="services"
  data-section="services"
  class="scroll-m-20 w-full mx-auto container lg:max-w-4xl md:max-w-2xl pb-16"
>
  <h2
    class="flex items-center mb-6 text-3xl
                font-semibold gap-x-3 text-black/80
                dark:text-white py-5"
  >
    <Checkicon class="size-8" />
    Services
  </h2>

  <div class="flex flex-col gap-y-9">
    {
      SERVICES.map(({ title, description, image, services }) => (
        <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
          

          <div class="w-full md:w-1/2 md:max-x-lg">
            <h3 class="text-2xl font-bold text-gray-800">{title}</h3>

            <div class="flex flex-wrap mt-2">
                <p class="mt-2 text-gray-700 dark:text-gray-400">
                    {description}
                </p>

                <ul class="mt-4 space-y-2">
                    {services.map((item) => (
                    <li class="flex items-start gap-x-2">
                        <Checkicon class="size-4 mt-1 text-yellow-500 shrink-0" />
                        <span class="text-gray-700 dark:text-gray-400">{item.a}</span>
                    </li>
                    <li class="flex items-start gap-x-2">
                        <Checkicon class="size-4 mt-1 text-yellow-500 shrink-0" />
                        <span class="text-gray-700 dark:text-gray-400">{item.b}</span>
                    </li>
                    <li class="flex items-start gap-x-2">
                        <Checkicon class="size-4 mt-1 text-yellow-500 shrink-0" />
                        <span class="text-gray-700 dark:text-gray-400">{item.c}</span>
                    </li>                   
                    ))}
                </ul>

            </div>
          </div>

          <div class="w-full md:w-1/2">
            <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-5 transition duration-500 ease-in-out transform shadow-xl overflow-clip md:group-hover:-translate-y-1 md:group-hover:shadow-2xl">
              <img
                src={image}                                
                alt="cover services"
                class="w-48 h-48 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
                loading="lazy"
              />              
            </div>
          </div>


        </article>
      ))
    }
  </div>
</section>
