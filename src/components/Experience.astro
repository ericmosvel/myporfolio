---
import Briefcase from "./icons/Briefcase.astro"
import ExperienceItem from "./ExperienceItem.astro"

const EXPERIENCE = [
  {
    date: "Present...",
    title: "Landing Pages Creator",
    company: "Independent",
    description:
      "design and develop tailored web solutions for businesses. My work ranges from persuasive landing pages and automation workflows to full content architectures that drive engagement and conversions.",
    link: "https://www.linkedin.com/in/ericmosquera/",
  },
  {
    date: "March 2024",
    title: "Freelancer Web Development",
    company: "Independent",
    description:
      "Built web components and led the content strategy for Bio-Cuerpo-Sano, ensuring a cohesive online presence and optimized user experience.",
  },
]


---

<section
  id="experiencia"
  data-section="Experience"
  class="section scroll-m-20 w-full mx-auto container lg:max-w-4xl md:max-w-2xl">
  <h2 
    class="flex items-center mb-6 text-3xl 
            font-semibold gap-x-3 text-black/80 
            dark:text-white py-5">
            <Briefcase class="size-8" />
            Experience
  </h2>
  <ol class="relative mt-6">
      {
          EXPERIENCE.map((experience) => (
              <li>
                  <ExperienceItem {...experience} />
              </li>
          ))
      }
  </ol>
</section>  



