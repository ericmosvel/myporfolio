---
const personalImageAlt = "Eric Mosvel"
import ProfileCheck from './icons/ProfileCheck.astro'


---



<section
  id="sobremi"
  data-section="sobremi"
  class="section scroll-m-20 w-full mx-auto container lg:max-w-4xl md:max-w-2xl py-8">

  <h2 
    class="flex items-center mb-6 text-3xl 
            font-semibold gap-x-3 text-black/80 
            dark:text-white">
            <ProfileCheck class="size-8" />
            About Me
  </h2> 
  <div class="flex flex-col gap-y-16"></div>

  <article class="flex flex-col items-center justify-center gap-8 text-gray-700 dark:text-gray-300 md:flex-row">
    <div class="[&>p]:mb-4 [&>strong]:text-yellow-500 dark:[&>p>strong]:text-yellow-100 [&>p>strong]:font-mono text-pretty order-2 md:order-1">

      <p>
        I’m Eric Mosvel, a developer who started out creating blogs as a hobby and eventually turned my passion into a career. 
        <strong>Today, I help professionals, entrepreneurs, and small businesses build a strong online presence.</strong>
      </p>

      <p>
        Some highlights of my journey:
      </p>

      <ul class="pl-2">
        <li>
          ● Developed a React.js web app that displays rinchment prompts with AI.
        </li>
        <li class="pt-1">
          ● Constantly working on personal projects and sharing them openly on GitHub.
        </li>
      </ul>
      
    </div>

    <img width="200" height="200"  src="/mek.jpg" alt={personalImageAlt} class="order-1 object-cover w-64 md:order-2 rotate-3 lg:w-64 aspect-square rounded-2xl bg-black/20 dark:bg-yellow-500/5 ring-1 ring-black/70 darK:ring-white/20" style="object-position: 50% 50%;">

  </article>



  

</section>